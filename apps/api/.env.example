# Port the API listens on.
PORT=3001

# Postgres connection string. Locally: docker compose up -d db
DATABASE_URL=postgresql://bgc:bgc@localhost:5432/bgc
# On Dokploy, paste the database's "Internal Connection URL" from its page.
# Alternative to DATABASE_URL, for passwords that would corrupt a URL:
# PGHOST=... PGPORT=5432 PGUSER=... PGPASSWORD=... PGDATABASE=...

# Comma-separated CORS allowlist. Set to your Vercel URL in production, e.g.
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=*

# Rooms older than this are purged hourly.
ROOM_TTL_HOURS=48

# Delay (ms) before the first SSE frame. See src/config.js. Leave at 0.
SSE_INITIAL_DELAY_MS=0
